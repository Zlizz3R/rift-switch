{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rift Switch",
  "version": "1.2.0",
  "identifier": "com.zlizz3r.riftswitch",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https://raw.communitydragon.org data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "scripts/autofill.ps1": "scripts/autofill.ps1", "scripts/rcmodal.ps1": "scripts/rcmodal.ps1" },
    "copyright": "Copyright © 2026 Zlizz3R",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
